import json
d=json.load(open("/tmp/opencode/spec_v3.json"))
print("== global security:", json.dumps(d.get('security')))
print("== OAuth2 scheme:", json.dumps(d.get('components',{}).get('securitySchemes',{}).get('OAuth2')))
print("== API key schemes:", json.dumps({k:v for k,v in d.get('components',{}).get('securitySchemes',{}).items()}))
# which ops have op-level security explicitly?
secs={}
for p,methods in d.get('paths',{}).items():
    for m,op in methods.items():
        if m not in ('get','post','put','patch','delete'): continue
        s=json.dumps(op.get('security'))
        secs.setdefault(s,[]).append(f"{m.upper()} {p}")
for k,v in secs.items():
    print(f"-- security {k}: {len(v)} ops")
    for x in v[:6]: print("   ",x)
EOF
